        {
          "id": "24c456ef-fd40-4577-90fc-a5e1f54d0203",
          "name": "Cisco Voice Portal Get Real-time Call Statistics",
          "request": {
            "name": "Cisco Voice Portal Get Real-time Call Statistics",
            "description": {
              "content": "Retrieves current real-time statistics across the CVP deployment, including active calls, calls per second, and resource utilization metrics. Data is refreshed at the reporting server polling interval.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "statistics",
                "realtime"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "serverId",
                  "value": "<string>",
                  "description": "Filter by specific server ID. If omitted, returns aggregate."
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP of the CVP OAMP Server",
                  "type": "any",
                  "value": "{{oamp-server}}",
                  "key": "oamp-server"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
