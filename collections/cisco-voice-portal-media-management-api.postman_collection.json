              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Audio file to upload"
                },
                {
                  "key": "path",
                  "value": "/",
                  "type": "text",
                  "description": "Target directory path"
                },
                {
                  "key": "overwrite",
                  "value": "false",
                  "type": "text",
                  "description": "Whether to overwrite existing file"
                }
              ]
            }
