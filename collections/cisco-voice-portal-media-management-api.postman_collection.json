          "name": "Cisco Voice Portal Upload a Media File",
          "request": {
            "name": "Cisco Voice Portal Upload a Media File",
            "description": {
              "content": "Uploads an audio media file (WAV, AU, or VOX format) to the VXML Server for use in voice prompts and announcements.",
              "type": "text/plain"
            },
            "url": {
