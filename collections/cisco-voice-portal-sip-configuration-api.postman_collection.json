          "id": "e9691a47-4411-4282-8bd6-586d5162331b",
          "name": "Cisco Voice Portal Create a Sip Server Group",
          "request": {
            "name": "Cisco Voice Portal Create a Sip Server Group",
            "description": {
              "content": "Creates a new SIP server group for call routing purposes. Server groups allow load balancing and failover across multiple SIP endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sipserver"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP of the CVP OAMP Server",
                  "type": "any",
                  "value": "{{oamp-server}}",
                  "key": "oamp-server"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupName\": \"<string>\",\n  \"servers\": [\n    {\n      \"hostname\": \"<string>\",\n      \"ipAddress\": \"<ipv4>\",\n      \"port\": 5060,\n      \"priority\": 1,\n      \"weight\": 100\n    },\n    {\n      \"hostname\": \"<string>\",\n      \"ipAddress\": \"<ipv4>\",\n      \"port\": 5060,\n      \"priority\": 1,\n      \"weight\": 100\n    }\n  ],\n  \"description\": \"<string>\",\n  \"loadBalancing\": \"round_robin\"\n}",
