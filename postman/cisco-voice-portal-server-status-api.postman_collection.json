            {
              "name": "Cisco Voice Portal Get Recent Server Log Entries",
              "id": "2ccd9193-18b4-4760-af41-0146aef4e4f6",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/server/log?level=INFO&since=<dateTime>&limit=100",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "server",
                    "log"
                  ],
                  "query": [
                    {
                      "description": "Minimum log level to include",
                      "key": "level",
                      "value": "INFO"
                    },
                    {
                      "description": "Return logs since this timestamp",
                      "key": "since",
                      "value": "<dateTime>"
                    },
                    {
                      "key": "limit",
                      "value": "100"
                    }
                  ]
                },
                "description": "Retrieves recent log entries from the VXML Server. Supports filtering by severity level and time range."
